# ── AI Provider (choose one; both optional – fallback works without any key) ──
# Google Gemini (recommended – free tier: 15 req/min, 1500 req/day)
# Get key: https://aistudio.google.com/app/apikey  → "Create API key"
GEMINI_API_KEY=your-gemini-api-key-here
# Model name – gemini-1.5-flash is free-tier; gemini-1.5-pro requires billing
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional – paid, ~$0.15/1M tokens)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── CORS (comma-separated allowed origins) ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── RAG (Phase 3) ───────────────────────────────────────────────────────────
# Embedding model for semantic search (downloaded from HuggingFace on first run)
# paraphrase-multilingual-MiniLM-L12-v2 supports English, Telugu and Hindi
RAG_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Directory for the SQLite vector store (relative to backend/)
RAG_DB_PATH=data/vector_store.db

# Authentication (generate a random secret: python -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET_KEY=your-random-secret-key-here-use-python-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
